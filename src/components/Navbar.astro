---
import ThemeIcon from '../../public/themeIcon.svg';
import Button from '@components/Button.astro';

const items = [
  {
    title: 'Home',
    path: '/',
  },
  {
    title: 'Services',
    path: '/services',
  },
  {
    title: 'Work',
    path: '/work',
  },
  {
    title: 'Contact',
    path: '/contact',
  },
  {
    title: 'Blog',
    path: '/blog',
  },
];
---

<div>
  <div>
    <ul
      class="mx-auto flex items-center justify-center bg-zinc-200 dark:bg-zinc-500"
    >
      <li class="m-2 basis-2/5">
        <a href="/"
          ><img
            src="/logo.svg"
            alt="Aptus Technica. Click for home."
            class="logo h-8 min-w-24"
          /></a
        >
      </li>
      {
        items.map((item) => (
          <li class="mx-1">
            <Button href={item.path}>{item.title}</Button>
          </li>
        ))
      }
      <li class="ml-2">
        <button
          id="theme-toggle"
          class="hover:bg-primary-dark focus:ring-primary-lighter dark:focus:ring-primary focus:ring-opacity-75 rounded-lg p-2 font-semibold text-white shadow-md focus:ring-2 focus:outline-none dark:focus:ring-2"
        >
          <ThemeIcon width={"20px"} />
        </button>
      </li>
    </ul>
  </div>
</div>
<style is:global>
  [data-theme] #theme-toggle:hover > svg {
    fill: white;
  }
  [data-theme='dark'] #theme-toggle > svg > .sun,
  [data-theme='light'] #theme-toggle > svg > .moon {
    fill: none;
  }
</style>
