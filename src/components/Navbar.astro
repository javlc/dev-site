    {
      title: 'Home',
      path: '/',
    },
    {
      title: 'Services',
      path: '/services',
    },
    {
      title: 'Work',
      path: '/work',
    },
    {
      title: 'Contact',
      path: '/contact',
    },
    {
       title: 'Blog',
       path: '/blog',
    },
];
