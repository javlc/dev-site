            items.map((item) => (
               <li>
                  <a href={item.path}>{item.title}</a>
               </li>
            ))
         }
         <li><button id="theme-toggle" class="px-4 py-2 bg-gray-200 dark:text-white dark:bg-gray-700 rounded-md">Toggle Theme</button></li>
      </ul>
   </div>
