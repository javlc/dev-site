---
// Click button, get confetti!
// Styled by Tailwind :)
---

<button id="confetti" class="py-2 px-4 bg-purple-500 text-white font-semibold rounded-lg shadow-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-opacity-75"
>
	<slot />
</button>

<script>
  import confetti from 'canvas-confetti';

  function confettiInit() {
    const button = document.querySelector('#confetti');

    async function hurlConfetti() {
      await confetti();
    }
    if (button) {
      button.addEventListener('click', () => hurlConfetti());
    }    
  }

  ["astro:page-load","astro:after-swap"].forEach((event) => {
    document.addEventListener(event, () => {
      confettiInit();
    });

  });
</script>
