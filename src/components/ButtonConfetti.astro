---
// Click button, get confetti!
// Styled by Tailwind :)
---

<button
  id="confetti"
  class="focus:ring-opacity-75 rounded-lg bg-teal-600 px-4 py-2 font-semibold text-white shadow-md hover:bg-teal-700 focus:ring-2 focus:ring-teal-400 focus:outline-none"
>
  <slot />
</button>

<script>
  import confetti from 'canvas-confetti';

  function confettiInit() {
    const button = document.querySelector('#confetti');

    async function hurlConfetti() {
      await confetti();
    }
    if (button) {
      button.addEventListener('click', () => hurlConfetti());
    }
  }

  ['astro:page-load', 'astro:after-swap'].forEach((event) => {
    document.addEventListener(event, () => {
      confettiInit();
    });
  });
</script>
