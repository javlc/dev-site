---
// Button.astro
interface Props {
  id?: string;
  color?: string;
  href?: string;
}
const {id, color, href} = Astro.props
---
{
  href ? 
    <a href={href} id={id || undefined} class="py-2 px-4 bg-primary text-aptec-white font-semibold rounded-lg shadow-md hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary-lighter focus:ring-opacity-75 cursor-pointer"><slot /></a> 
    :
    <button id={id || undefined} class="py-2 px-4 bg-primary text-aptec-white font-semibold rounded-lg shadow-md hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary-lighter focus:ring-opacity-75 cursor-pointer">
	  <slot />
    </button>
}
