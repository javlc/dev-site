---
// Button.astro
interface Props {
  id?: string;
  color?: string;
  href?: string;
}
const { id, color, href } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      id={id || undefined}
      class="bg-primary text-aptec-white hover:bg-primary-dark focus:ring-primary-lighter focus:ring-opacity-75 cursor-pointer rounded-lg px-4 py-2 font-semibold shadow-md focus:ring-2 focus:outline-none"
    >
      <slot />
    </a>
  ) : (
    <button
      id={id || undefined}
      class="bg-primary text-aptec-white hover:bg-primary-dark focus:ring-primary-lighter focus:ring-opacity-75 cursor-pointer rounded-lg px-4 py-2 font-semibold shadow-md focus:ring-2 focus:outline-none"
    >
      <slot />
    </button>
  )
}
