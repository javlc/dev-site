---
// Layout import
import BaseLayout from '@layouts/BaseLayout.astro';
// Component Imports
import ButtonConfetti from '@components/ButtonConfetti.astro';
import Button from '@components/Button.astro';

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
const title = 'My Astro + TailwindCSS';
---

<BaseLayout pageTitle={title}>
   <div class="grid h-screen place-items-center content-center">
      <ButtonConfetti>Tailwind Button in Astro!</ButtonConfetti>
      <a href="/markdown-page" class="p-4 underline"
         >Markdown is also supported...</a
      >
   </div>
</BaseLayout>
