{
   "trailingComma": "es5",
   "tabWidth": 3,
   "semi": true,
   "singleQuote": true,
   "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
   "overrides": [
      {
         "files": ".prettierrc",
         "options": {
            "parser": "json"
         }
      },
      {
         "files": "*.astro",
         "options": {
            "parser": "astro"
         }
      }
   ]
}
